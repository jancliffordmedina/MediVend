# /etc/udev/rules.d/99-medivend-hardware.rules
# Give the gpio and i2c groups access to GPIO character devices and I2C buses,
# so the hardware service does not run as root. Create the groups first:
#   sudo groupadd --system gpio; sudo groupadd --system i2c
# Then: sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"
