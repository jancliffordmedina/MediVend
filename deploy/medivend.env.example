# Copy to /etc/medivend/medivend.env, owned by root:medivend, mode 0640.
# Examples only; replace the password locally. Never commit the real file.
MEDIVEND_MODE=hardware
MEDIVEND_DB_HOST=localhost
MEDIVEND_DB_PORT=3306
MEDIVEND_DB_NAME=medivend_db
MEDIVEND_DB_USER=medivend_app
MEDIVEND_DB_PASSWORD="REPLACE_WITH_A_LOCAL_SECRET"
# Leave unconfigured until specifications and physical acceptance tests exist.
MEDIVEND_HARDWARE_ADAPTER=""
MEDIVEND_DELIVERY_TIMEOUT_SECONDS=0
MEDIVEND_WORKER_LOCK=/run/medivend/worker.lock

# Optional staff stock room: no account is enabled until configured privately.
# On the Orange Pi, run from /srv/medivend:
# sudo php scripts/setup-staff.php --username staff --env-file /etc/medivend/medivend.env
# Enter a 12-to-72-byte password at the hidden prompts; restart Apache afterwards.
# The setup script writes MEDIVEND_STAFF_USERNAME and MEDIVEND_STAFF_PASSWORD_HASH.
# Do not copy this template over an existing private environment during an update.
# Keep MEDIVEND_MODE=simulation for a prototype without verified physical hardware.
# MEDIVEND_STAFF_RATE_DIR=/var/lib/medivend/staff-rate
# If set, use a private directory outside the web root, writable by Apache.
